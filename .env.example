
# --- Database ---
DATABASE_URL=postgresql://juris_user:juris_password@localhost:5432/juris_db

# --- App ---
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# --- LLM / Embeddings (added in later phases) ---
OPENAI_API_KEY=
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# --- Storage / Models (added in later phases) ---
STORAGE_DIR=storage/documents
FAISS_INDEX_DIR=models/vector_store

# --- LLM (Phase 13) ---
# Gemini API configuration
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
GEMINI_API_KEY=your_gemini_api_key_here

# Keep these empty if you are not using these providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=